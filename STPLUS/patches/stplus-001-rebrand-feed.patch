+                    Object nestedRecyclerView = Helpers.getField(viewHolder, "mNestedRecyclerView");
+                    if (nestedRecyclerView instanceof WeakReference) {
+                        Object recyclerView = ((WeakReference<?>) nestedRecyclerView).get();
